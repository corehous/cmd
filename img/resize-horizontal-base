# 이미지 파일만 추려서 지정된 가로 크기(px)로 리사이즈
# 하위 폴더는 처리하지 않음
# 원본 가로세로 비율 유지
# 작은 이미지도 확대
# 원본 파일 형식 유지
# 파일명: 가로x세로 + 랜덤 영문소문자 3자리
# 파일명 중복 방지
# 결과 파일은 새 폴더에 저장


# 설정: 가로 크기(px)
$targetWidth = 1000


# 출력 폴더
$outDir = "resized_${targetWidth}px"

New-Item -ItemType Directory -Force -Path $outDir | Out-Null


# 랜덤 영문 소문자 3자리 생성
function Get-RandomLetters {
    return -join (97..122 | Get-Random -Count 3 | ForEach-Object {
        [char]$_
    })
}


# 중복 방지
$usedNames = @{}


# 이미지 처리
Get-ChildItem -File | Where-Object {
    $_.Extension -match '(?i)^\.(jpg|jpeg|png|webp|bmp|tiff)$'
} | ForEach-Object {

    $input = $_.FullName
    $ext = $_.Extension.ToLower()

    # 임시 파일 생성
    $tempFile = "$env:TEMP\temp_$([guid]::NewGuid())$ext"

    # 가로 기준 리사이즈
    magick "$input" `
        -auto-orient `
        -resize "${targetWidth}x" `
        "$tempFile"

    # 변환 실패 확인
    if (!(Test-Path -LiteralPath $tempFile)) {
        Write-Host "변환 실패: $($_.Name)"
        return
    }

    # 리사이즈된 실제 크기 확인
    $info = (magick identify -format "%w %h" "$tempFile").Trim()
    $w, $h = $info -split "\s+"

    # 실제 크기 + 랜덤 3자리 파일명 생성
    do {
        $rand = Get-RandomLetters
        $fileName = "${w}x${h}${rand}${ext}"
        $output = Join-Path $outDir $fileName

    } while (
        ($usedNames.ContainsKey($fileName)) -or
        (Test-Path -LiteralPath $output)
    )

    $usedNames[$fileName] = $true

    # 최종 위치로 이동
    Move-Item -LiteralPath $tempFile -Destination $output

    Write-Host "완료: $($_.Name) → $fileName"
}

Write-Host "`n완료! 결과는 '$outDir' 폴더에 저장되었습니다."
