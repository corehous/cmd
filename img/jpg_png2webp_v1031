# Source: Current folder
# Output: New folder named webp
# Filename: widthxheightx3-random-characters.webp

$outputFolder = Join-Path (Get-Location) "webp"

# Create output folder
New-Item -ItemType Directory -Path $outputFolder -Force | Out-Null

# Find PNG and JPG files in the current folder only
$files = Get-ChildItem -File |
    Where-Object { $_.Extension -match '^\.(png|jpe?g)$' }

foreach ($file in $files) {

    # Get original image dimensions
    $dimensions = magick identify -format "%w %h" "$($file.FullName)"

    if ($LASTEXITCODE -ne 0 -or -not $dimensions) {
        Write-Warning "Failed to read: $($file.Name)"
        continue
    }

    $width, $height = $dimensions -split '\s+'

    # Generate 3 random lowercase letters
    $random = -join (1..3 | ForEach-Object {
        [char](Get-Random -Minimum 97 -Maximum 123)
    })

    # Build output filename
    $newName = "${width}x${height}x${random}.webp"
    $outputPath = Join-Path $outputFolder $newName

    # Convert to WebP
    magick "$($file.FullName)" -strip -quality 85 "$outputPath"

    if ($LASTEXITCODE -eq 0) {
        Write-Host "Converted: $($file.Name) -> $newName"
    }
    else {
        Write-Warning "Conversion failed: $($file.Name)"
    }
}

Write-Host "`nComplete! Output folder: $outputFolder"
